<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes de carga, performance e segurança sob carga: concorrência, alocação por Send, volume, soak (longa duração),
    carga HTTP e ataques na API de exemplo. Nada daqui roda no CI de pull request: os testes rápidos (Carga-CI) e os pesados
    (Carga-Pesada, com [Explicit]) só rodam sob demanda, no workflow manual performance.yml, ou localmente com filtro (veja
    docs/testes.md). Framework, lock file e auditoria em ../build/Tec.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Cqrs\TEC.Cqrs.csproj" />
    <ProjectReference Include="..\samples\TEC.Cqrs.SampleApi\TEC.Cqrs.SampleApi.csproj" />
    <ProjectReference Include="..\samples\TEC.Cqrs.LoadGenerator\TEC.Cqrs.LoadGenerator.csproj" />
  </ItemGroup>

</Project>
