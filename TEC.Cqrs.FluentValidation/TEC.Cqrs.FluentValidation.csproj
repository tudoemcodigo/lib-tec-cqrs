<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações de build, segurança, AOT e metadados comuns: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>TEC.Cqrs.FluentValidation</RootNamespace>
    <Description>Adiciona ao TEC.Cqrs a validação declarativa de cada requisição: verifica a entrada antes da regra de negócio e devolve um erro claro por campo inválido.</Description>
    <PackageTags>cqrs;mediator;fluentvalidation;validation;tec</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Cqrs\TEC.Cqrs.csproj" />
  </ItemGroup>

  <!--
    O TEC.Cqrs expõe os internos a este pacote (InternalsVisibleTo), inclusive o polyfill System.Threading.Lock do net8.0
    (build/Polyfills). Uma segunda cópia compilada aqui conflitaria com a do núcleo (CS0436): este pacote usa a do núcleo.
  -->
  <ItemGroup>
    <Compile Remove="$(TecRepoRoot)build/Polyfills/Lock.cs" />
  </ItemGroup>

</Project>
